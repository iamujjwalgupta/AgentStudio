# Postgres connection for Agent Studio itself
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_studio?schema=public"

# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Any long random string. Used to sign session cookies and encrypt connection secrets.
AUTH_SECRET="change-me-to-a-long-random-string"

# Where generated artifacts and uploads are written
STORAGE_DIR="./storage"

# Shared secret the scheduler uses to call /api/cron. Any long random string.
CRON_SECRET="change-me-to-a-long-random-string"

# Where the scheduler should reach the app.
APP_URL="http://localhost:3000"
