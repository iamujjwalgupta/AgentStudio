# Postgres connection for Agent Studio itself
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_studio?schema=public"

# Optional: a Google Gemini API key (https://aistudio.google.com/apikey). Agents run
# on Gemini. Usually the key is added in the app instead, under Connections; this one
# is the fallback for a workspace that has none there.
# GEMINI_API_KEY="AIza..."

# Optional: lets an Azure OpenAI or OpenAI-compatible connection point at a private
# address (a self-hosted Ollama on localhost or the VPC). Off by default.
# ALLOW_PRIVATE_MODEL_URLS="true"

# Any long random string. Used to sign session cookies and encrypt connection secrets.
AUTH_SECRET="change-me-to-a-long-random-string"

# Where generated artifacts and uploads are written
STORAGE_DIR="./storage"

# Shared secret the scheduler uses to call /api/cron. Any long random string.
CRON_SECRET="change-me-to-a-long-random-string"

# Where the scheduler should reach the app.
APP_URL="http://localhost:3000"
